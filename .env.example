# Copy to .env and fill in. Never commit .env — it is gitignored.
#
# Every line says "export" because nothing in the program reads this file: the
# bot reads the environment, and these files are shell scripts you source.
# Without "export", `source .env` sets shell variables that `go run` never
# inherits, and the run reports no credentials configured.
#
# Platform credentials are scoped to a *channel*: one set of accounts, serving
# one or more jurisdictions. Every platform variable carries the channel key as
# a prefix, and there is no fallback to an unprefixed name — a channel missing a
# secret comes up empty rather than borrowing another channel's credentials and
# posting to the wrong account. Two channels exist: "zurich" (Gemeinderat and
# Kantonsrat) and "chparl" (Nationalrat). main.go posts every channel unless
# CHANNEL names one; each GitHub workflow sets it to its own.
#
# Settings that are not per-account (MAX_VOTES_TO_CHECK) or are per-jurisdiction
# (MAX_VOTE_AGE_DAYS_*, JURISDICTION_*_ENABLED) carry no channel prefix.

# --- Channel "zurich": X API credentials (OAuth 1.0a User Context) ---
# https://developer.x.com/en/portal/dashboard → Projects & Apps → Keys and tokens
export ZURICH_X_API_KEY=
export ZURICH_X_API_SECRET=
export ZURICH_X_ACCESS_TOKEN=
export ZURICH_X_ACCESS_SECRET=

# --- Channel "zurich": Bluesky ---
export ZURICH_BLUESKY_HANDLE=
export ZURICH_BLUESKY_PASSWORD=

# --- Channel "zurich": Instagram ---
# See pkg/igapi/README.md for setup instructions.
export ZURICH_IG_USER_ID=
export ZURICH_IG_ACCESS_TOKEN=

# --- Channel "zurich": image hosting ---
# Instagram fetches carousel images by URL rather than accepting an upload, so
# they are published to a GitHub repo's gh-pages branch first and deleted after.
# This is a GitHub repo and a GitHub token, not Instagram credentials.
#
# "owner/name". In GitHub Actions both come from the workflow context; set them
# by hand only for local runs. The token needs Contents read/write on that repo.
export ZURICH_IMAGE_HOST_REPO=SiiiTschiii/parlinfo
export ZURICH_IMAGE_HOST_TOKEN=

# --- Channel "zurich": per-run post budget ---
# The budget belongs to the account, so it is shared across every jurisdiction
# the channel serves. X Free tier: 17 posts per 24h, 500 per month.
export ZURICH_X_MAX_POSTS_PER_RUN=2
export ZURICH_BLUESKY_MAX_POSTS_PER_RUN=2
export ZURICH_IG_MAX_POSTS_PER_RUN=2
# 280 for free X accounts, 2000 for Premium.
export ZURICH_X_MAX_CHARS=280

# --- Run settings ---
# How many recent votes to fetch per jurisdiction when looking for new ones.
export MAX_VOTES_TO_CHECK=4

# --- Jurisdictions ---
# Age guard per body, in days. Defaults live in pkg/config/jurisdictions.go
# (city 90, canton 14); set these only to override.
# export MAX_VOTE_AGE_DAYS_ZURICH_CITY=90
# export MAX_VOTE_AGE_DAYS_ZURICH_CANTON=14
#
# Per-body switch. Nothing posts unless set to "true" — including the city.
# Set either to "false" to pause that body on its own.
export JURISDICTION_ZURICH_CITY_ENABLED=true
# export JURISDICTION_ZURICH_CANTON_ENABLED=true
# export JURISDICTION_NATIONALRAT_ENABLED=true
# First sitting date posted, on every platform. Optional, but Facebook refuses to
# start without one (here or as <CHANNEL>_FB_POST_FROM).
# export JURISDICTION_NATIONALRAT_POST_FROM=2026-09-28
# export MAX_VOTE_AGE_DAYS_NATIONALRAT=14

# --- Channel "chparl": the Nationalrat's accounts ---
# Same names as the zurich channel, prefixed CHPARL_ — X, Bluesky, Instagram
# and Facebook alike. SETUP.md lists what each needs.
# export CHANNEL=chparl
# export CHPARL_X_API_KEY=
# export CHPARL_X_API_SECRET=
# export CHPARL_X_ACCESS_TOKEN=
# export CHPARL_X_ACCESS_SECRET=
# export CHPARL_BLUESKY_HANDLE=chparlinfo.bsky.social
# export CHPARL_BLUESKY_PASSWORD=
# export CHPARL_X_MAX_POSTS_PER_RUN=1
# export CHPARL_BLUESKY_MAX_POSTS_PER_RUN=1
# export CHPARL_IG_USER_ID=
# export CHPARL_IG_ACCESS_TOKEN=
# export CHPARL_IMAGE_HOST_REPO=SiiiTschiii/parlinfo
# export CHPARL_IMAGE_HOST_TOKEN=
# export CHPARL_IG_MAX_POSTS_PER_RUN=2
