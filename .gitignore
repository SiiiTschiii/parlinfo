# --custom message files also carry personal emails — keep local.
# Only the schema example is committed.
data/campaign_messages/*
!data/campaign_messages/*.example.yaml

out/

# Claude Code (local, machine-specific)
.claude/settings.local.json
.claude/worktrees/

# Vote state logs live on the `state-log` branch, not here. The bot restores
# them into the checkout at runtime; they must never be committed to main.
# Both the per-jurisdiction layout and the flat one it replaced are covered.
data/*/posted_votes_*.json
data/*/posted_geschaefte_*.json
data/posted_votes_*.json
